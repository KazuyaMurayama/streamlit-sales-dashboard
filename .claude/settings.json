{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/pre_read_guard.py || python3 .claude/hooks/pre_read_guard.py || exit 0"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/pre_reinject_guard.py || python3 .claude/hooks/pre_reinject_guard.py || exit 0"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/pre_write_guard.py || python3 .claude/hooks/pre_write_guard.py || exit 0"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/pre_md_table_guard.py || python3 .claude/hooks/pre_md_table_guard.py || exit 0"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/md_date_guard.py || python3 .claude/hooks/md_date_guard.py || exit 0"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/pre_report_quality_guard.py || python3 .claude/hooks/pre_report_quality_guard.py || exit 0"
          }
        ]
      },
      {
        "matcher": "Grep|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/pre_index_read_guard.py || python3 .claude/hooks/pre_index_read_guard.py || exit 0"
          }
        ]
      },
      {
        "matcher": "mcp__.*Gmail__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/pre_mail_search_guard.py || python3 .claude/hooks/pre_mail_search_guard.py || exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/post_bash_guard.py || python3 .claude/hooks/post_bash_guard.py || exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session_guard.py || python3 .claude/hooks/session_guard.py || exit 0"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/review_gate.py || python3 .claude/hooks/review_gate.py || exit 0"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/notfound_guard.py || python3 .claude/hooks/notfound_guard.py || exit 0"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/unverified_identifier_guard.py || python3 .claude/hooks/unverified_identifier_guard.py || exit 0"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/countermeasure_gate.py || python3 .claude/hooks/countermeasure_gate.py || exit 0"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/reqspec_gate.py || python3 .claude/hooks/reqspec_gate.py || exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session_start_freshness.py || python3 .claude/hooks/session_start_freshness.py || exit 0"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_RETRY_WATCHDOG": "1"
  }
}
